---
title: "Live Music"
layout: default
---

<h1>{{ title }}</h1>
<div class="videos" style="display:flex; flex-wrap:wrap; justify-content:center; gap:2em;">
  {% for video in collections.videos %}
    <div class="video" style="background:#fff; border-radius:8px; box-shadow:0 2px 8px #0002; padding:1em; width:350px;">
      <iframe src="https://www.youtube.com/embed/{{ video.data.youtube_id }}" allowfullscreen style="width:100%; height:197px; border-radius:8px; border:none;"></iframe>
      <div class="title" style="font-size:1.1em; margin:0.5em 0;">{{ video.data.title }}</div>
      {% if video.data.description %}
        <div class="desc" style="font-size:0.95em;">{{ video.data.description }}</div>
      {% endif %}
      <a class="yt-link" href="https://www.youtube.com/watch?v={{ video.data.youtube_id }}" target="_blank" style="font-size:0.9em;">Watch on YouTube</a>
    </div>
  {% endfor %}
</div>