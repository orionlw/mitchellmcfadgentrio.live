---
title: "Events"
layout: "default"
---

<h1 class="text-3xl font-bold text-center my-8 text-indigo-700">{{ title }}</h1>

<div class="max-w-3xl mx-auto px-4">
  <section class="mb-12">
    <h2 class="text-2xl font-semibold mb-6 text-indigo-600">Upcoming Events</h2>
    <div class="space-y-8">
      {% for event in collections.current_events %}
        <div class="bg-white rounded-lg shadow-lg p-6 border border-indigo-100">
          <div class="font-bold text-xl text-indigo-700 mb-2">{{ event.data.title }}</div>
          <div class="text-gray-500 mb-2 flex flex-wrap items-center gap-4">
            <span class="inline-flex items-center">
              <!-- Extra Small Calendar Icon (no width/height attributes) -->
              <svg class="w-3 h-3 mr-1 align-middle text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="3" y="8" width="18" height="13" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
                <path d="M16 2v4M8 2v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              {{ event.data.date | date("dddd, MMMM D, YYYY h:mm A") }}
            </span>
            {% if event.data.location %}
              <span class="inline-flex items-center">
                <!-- Extra Small Location Pin Icon (no width/height attributes) -->
                <svg class="w-3 h-3 mr-1 align-middle text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 11a3 3 0 100-6 3 3 0 000 6zm0 0c-4.418 0-8 2.239-8 5v5a2 2 0 002 2h12a2 2 0 002-2v-5c0-2.761-3.582-5-8-5z"/>
                </svg>
                {{ event.data.location }}
              </span>
            {% endif %}
          </div>
          {% if event.data.description %}
            <div class="text-gray-700 mb-2">{{ event.data.description }}</div>
          {% endif %}
          {% if event.data.url %}
            <a class="inline-block mt-2 text-indigo-500 hover:text-indigo-700 font-medium underline" href="{{ event.data.url }}" target="_blank">More info</a>
          {% endif %}
        </div>
      {% else %}
        <div class="text-gray-400 italic">No upcoming events at this time.</div>
      {% endfor %}
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-semibold mb-6 text-gray-600">Past Events</h2>
    <div class="space-y-8">
      {% for event in collections.past_events %}
        <div class="bg-gray-50 rounded-lg shadow p-6 border border-gray-200">
          <div class="font-bold text-lg text-gray-700 mb-2">{{ event.data.title }}</div>
          <div class="text-gray-500 mb-2 flex flex-wrap items-center gap-4">
            <span class="inline-flex items-center">
              <!-- Extra Small Calendar Icon (no width/height attributes) -->
              <svg class="w-3 h-3 mr-1 align-middle text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="3" y="8" width="18" height="13" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
                <path d="M16 2v4M8 2v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              {{ event.data.date | date("dddd, MMMM D, YYYY h:mm A") }}
            </span>
            {% if event.data.location %}
              <span class="inline-flex items-center">
                <!-- Extra Small Location Pin Icon (no width/height attributes) -->
                <svg class="w-3 h-3 mr-1 align-middle text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 11a3 3 0 100-6 3 3 0 000 6zm0 0c-4.418 0-8 2.239-8 5v5a2 2 0 002 2h12a2 2 0 002-2v-5c0-2.761-3.582-5-8-5z"/>
                </svg>
                {{ event.data.location }}
              </span>
            {% endif %}
          </div>
          {% if event.data.description %}
            <div class="text-gray-600 mb-2">{{ event.data.description }}</div>
          {% endif %}
          {% if event.data.url %}
            <a class="inline-block mt-2 text-indigo-400 hover:text-indigo-600 font-medium underline" href="{{ event.data.url }}" target="_blank">More info</a>
          {% endif %}
        </div>
      {% else %}
        <div class="text-gray-400 italic">No past events yet.</div>
      {% endfor %}
    </div>
  </section>
</div>
